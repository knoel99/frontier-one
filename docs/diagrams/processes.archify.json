  "cards": [
    {
      "dot": "cyan",
      "title": "Executed vs read",
      "items": [
        "Executed boxes (see the legend): launcher, gateway and watchdog threads in one process; mcp.py and the tool modules in another, a child of the harness",
        "The harness reads AGENTS.md, then MISSION.md and TOOLS.md, and starts bin/frontier-mcp because .codex/config.toml names it",
        "mission.prepare wrote every workspace instruction and harness file before session 1"
      ]
    },
    {
      "dot": "rose",
      "title": "Ledgers in the state dir",
      "items": [
        "llm.jsonl and events.jsonl are hash-chained; reservations.json holds calls in flight",
        "Gateway charges the harness traffic; agent.py charges sub-agents; infra.py records machines in resources.json",
        "Both watchdogs read resources.json and delete what overran"
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn as boxes",
      "items": [
        "Native sub-agents (.codex/agents/*.toml) run inside the harness process, on its routed model provider",
        "OpenShell variant: the host keeps the watchdog; gateway, harness and MCP run in the sandbox via frontier mission session; box.pull() copies workspace and state back",
        "Owner tools: frontier dashboard (read-only) and frontier reap (cron)"
      ]
    }
  ]
