  "cards": [
    {
      "dot": "amber",
      "title": "Three stop conditions",
      "items": [
        "delivery.json exists: the AI called deliver",
        "hours_left <= 0: the deadline passed (a session is also killed at the deadline)",
        "llm_allowed() fails: the LLM budget is spent"
      ]
    },
    {
      "dot": "cyan",
      "title": "What runs when",
      "items": [
        "prepare writes AGENTS.md, MISSION.md, TOOLS.md, subject/ and the harness files, then budgets.json, mission.json, events.jsonl",
        "Each session gets FRONTIER_STATE, bin/ on PATH and a model base URL on the gateway",
        "Unrouted harness: its spend is read from its own usage report"
      ]
    },
    {
      "dot": "slate",
      "title": "Run by the owner, outside the loop",
      "items": [
        "frontier dashboard (dashboard.py): read-only view of the ledgers",
        "frontier reap <state> from cron: dead-man sweep (infra.reap)"
      ]
    }
  ]
